 """Turn raw text into a list of words."""
 
+import re
+
+# A word is a run of letters/digits (any script; underscore excluded), optionally
+# joined to further runs by a single internal apostrophe or hyphen, so that
+# "don't", "rock'n'roll" and "well-known" stay whole. Everything else --
+# surrounding punctuation, quotes, dashes standing alone, underscores -- is a
+# separator and never part of a word.
+_WORD_CHARS = r"[^\W_]+"
+_JOINERS = r"['’-]"  # ASCII apostrophe, typographic apostrophe, hyphen
+_WORD_RE = re.compile(rf"{_WORD_CHARS}(?:{_JOINERS}{_WORD_CHARS})*")
+
 
 def tokenize(text):
-    """Split text into lowercase words."""
-    return text.lower().split()
+    """Split text into lowercase words, dropping punctuation.
+
+    >>> tokenize("Hello, world! Don't stop - it's well-known.")
+    ['hello', 'world', "don't", 'stop', "it's", 'well-known']
+    """
+    return _WORD_RE.findall(text.lower())
