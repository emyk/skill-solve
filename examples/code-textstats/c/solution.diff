new file mode 100644
index 0000000..8ab30a1
--- /dev/null
+++ b/tests/test_tokenize.py
@@ -0,0 +1,28 @@
+from textstats import average_word_length
+from textstats.tokenize import tokenize
+
+
+def test_strips_surrounding_punctuation():
+    assert tokenize('"Hello," she said... (quietly)!') == ["hello", "she", "said", "quietly"]
+
+
+def test_punctuation_between_words_without_spaces_splits_them():
+    assert tokenize("one,two;three") == ["one", "two", "three"]
+
+
+def test_keeps_internal_apostrophes_and_hyphens():
+    assert tokenize("Don't stop, well-known rock’n’roll") == [
+        "don't", "stop", "well-known", "rock’n’roll",
+    ]
+
+
+def test_dangling_hyphens_and_quotes_are_not_words():
+    assert tokenize("-- 'quoted' - x-") == ["quoted", "x"]
+
+
+def test_non_ascii_letters_and_digits_are_words():
+    assert tokenize("Café 42 naïve") == ["café", "42", "naïve"]
+
+
+def test_punctuation_does_not_inflate_average_word_length():
+    assert average_word_length("ab, abcd!") == 3.0
