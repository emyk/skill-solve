index 86cbbe9..2ec455e 100644
--- a/tests/test_stats.py
+++ b/tests/test_stats.py
@@ -1,3 +1,5 @@
+from collections import Counter
+
 from textstats import word_frequencies, top_words, average_word_length
 
 
@@ -19,3 +21,27 @@ def test_average_word_length_empty():
 
 def test_average_word_length_simple():
     assert average_word_length("ab abcd") == 3.0
+
+
+def test_punctuation_does_not_stick_to_words():
+    assert top_words("Hello, world! Hello.") == [("hello", 2), ("world", 1)]
+
+
+def test_punctuation_without_spaces_still_separates_words():
+    assert top_words("Hello,world! Hello.") == [("hello", 2), ("world", 1)]
+
+
+def test_punctuation_only_tokens_are_not_words():
+    assert word_frequencies("well - that is that") == Counter({"that": 2, "well": 1, "is": 1})
+
+
+def test_curly_and_straight_apostrophes_are_the_same_word():
+    assert word_frequencies("Don’t don't")["don't"] == 2
+
+
+def test_decomposed_accents_stay_in_one_word():
+    assert word_frequencies("naïve")["naïve"] == 1
+
+
+def test_punctuation_does_not_count_toward_word_length():
+    assert average_word_length("Hello, world!") == 5.0
diff --git a/textstats/tokenize.py b/textstats/tokenize.py
index d3970d5..a766613 100644
--- a/textstats/tokenize.py
+++ b/textstats/tokenize.py
@@ -1,6 +1,16 @@
 """Turn raw text into a list of words."""
 
+import re
+import unicodedata
+
+# A word is a run of letters/digits (any script), optionally joined by internal
+# apostrophes or hyphens: "don't", "well-known". Punctuation around words, and
+# tokens with no letters/digits at all ("-", "!!!"), are not words.
+_WORD_RE = re.compile(r"[^\W_]+(?:['-][^\W_]+)*")
+_APOSTROPHES = str.maketrans({"’": "'", "‘": "'"})  # curly -> straight
+
 
 def tokenize(text):
-    """Split text into lowercase words."""
-    return text.lower().split()
+    """Split text into lowercase words, ignoring surrounding punctuation."""
+    text = unicodedata.normalize("NFC", text).lower().translate(_APOSTROPHES)
+    return _WORD_RE.findall(text)
